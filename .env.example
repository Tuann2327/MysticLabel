# Copy to .env and fill in. .env is gitignored; this template is not.
#
# Used server-side by the Netlify functions:
#   netlify/functions/shopify-proxy.mjs    order import
#   netlify/functions/shopify-product.mjs  picking-list product lookup
#
# Store handle only — the subdomain of <handle>.myshopify.com, not a full URL.
SHOPIFY_STORE=
#
# Admin API access token, starts with shpat_
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> your app -> API credentials -> Admin API access token
# Required scopes: read_orders, read_products, read_inventory
SHOPIFY_TOKEN=

# Only needed if you also run plain `npm run dev` (Vite's own proxy).
# Under `netlify dev` these are ignored — the two above are used instead.
VITE_SHOPIFY_STORE=
VITE_SHOPIFY_TOKEN=
